# VideoBrief 环境变量
# 复制此文件为 .env 并填入真实值

# DeepSeek API（OpenAI-compatible）
VIDEOBRIEF_LLM_PROVIDER=deepseek
VIDEOBRIEF_LLM_BASE_URL=https://api.deepseek.com
VIDEOBRIEF_LLM_MODEL=deepseek-chat
VIDEOBRIEF_LLM_API_KEY=填写你的DeepSeek_Key

# 服务端口（可选，默认 12000）
# VIDEOBRIEF_PORT=12000

# 后台任务并发上限（可选，默认 2）
# VIDEOBRIEF_MAX_CONCURRENT_JOBS=2

# 上传文件目录（可选，默认 ./uploads）
# VIDEOBRIEF_UPLOAD_DIR=./uploads

# 历史数据库（可选，默认 ./videobrief.db）
# VIDEOBRIEF_DB_PATH=./videobrief.db
